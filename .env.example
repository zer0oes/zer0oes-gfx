# Copier ce fichier en .env.local et compléter.
# Sans STRIPE_SECRET_KEY, le site tourne en mode démo (le bouton Commander mène directement à /merci).

# URL publique du site (ex. https://zer0oes-gfx.vercel.app). Optionnel en local.
NEXT_PUBLIC_SITE_URL=

# Stripe — Dashboard > Développeurs > Clés API (utiliser la clé de test sk_test_… pour commencer)
STRIPE_SECRET_KEY=
# Secret du webhook /api/stripe/webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Envoi des formulaires par e-mail via Resend (optionnel : sinon ils s'affichent dans les logs serveur)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
