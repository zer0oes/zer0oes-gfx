# Copier ce fichier en .env.local (local) ou créer ces variables dans l'hébergeur.
# Ne jamais committer .env.local ni aucune valeur secrète.
# Sans clés, le site tourne en mode démo (paiements simulés, données de src/data).

# --- Site ---------------------------------------------------------------------
# URL publique du site, sans « / » final. Figée au build (NEXT_PUBLIC_*).
# Ex. https://zer0oes-gfx.herokuapp.com en attendant le domaine.
NEXT_PUBLIC_SITE_URL=

# --- Stripe (Dashboard Stripe > Développeurs > Clés API / Webhooks) -------------
# Clé secrète : sk_test_… pour tester, sk_live_… en production.
STRIPE_SECRET_KEY=
# Secret de signature du webhook https://<domaine>/api/stripe/webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=

# --- Supabase (Project Settings > API) ------------------------------------------
# URL du projet. Figée au build.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique « publishable » (ou ancienne clé « anon »). Figée au build.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (« secret » ou ancienne « service_role ») : serveur uniquement.
SUPABASE_SECRET_KEY=

# --- Accès admin ----------------------------------------------------------------
# E-mails autorisés à se connecter à /admin (séparés par des virgules).
ADMIN_EMAILS=zer0oes.pro@gmail.com

# --- E-mails (Resend : resend.com > API Keys) -----------------------------------
# Sans clé, les e-mails sont seulement affichés dans les logs serveur.
RESEND_API_KEY=
# Adresse qui reçoit les notifications (commandes, briefs, contact).
NOTIFY_EMAIL=zer0oes.pro@gmail.com
# Expéditeur, sur un domaine vérifié dans Resend. Ex. zer0oes gfx <contact@ton-domaine.fr>
NOTIFY_FROM=

# --- Factures Abby (my.app-abby.com > Paramètres > Intégrations) ------------------
# Sans clé : factures simulées (mode démo).
ABBY_API_KEY=
# Code TVA des lignes de facture (défaut FR_00HT : franchise en base de TVA).
ABBY_VAT_CODE=
# Factures réelles seulement avec une clé Stripe live (sk_live_…) ; mettre 1 pour
# en créer aussi avec une clé de test. Les commandes de démo restent toujours simulées.
ABBY_IN_TEST_MODE=

# --- Développement uniquement : NE JAMAIS DÉFINIR EN PRODUCTION ------------------
# (refusés de toute façon si NODE_ENV=production)
# ADMIN_DEV_LOGIN=1     connexion admin sans Supabase, à mettre dans .env.development.local
# ADMIN_SESSION_SECRET= secret de la connexion de dev (sinon généré au démarrage)
# LOCAL_STORE=0         désactive le magasin JSON local en développement
